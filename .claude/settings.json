{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Workflow(work-item-001-go-skeleton-and-init)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "simple-english@simple-english": true
  },
  "outputStyle": "simple-english:simple-english",
  "worktree": {
    "baseRef": "head",
    "bgIsolation": "worktree"
  },
  "askUserQuestionTimeout": "10m",
  "autoMemoryEnabled": true,
  "cleanupPeriodDays": 30
}
